include README.md
include LICENSE
include VERSION
include *.yml
include *.yaml
include *.txt

# Include source files
recursive-include lmcache *.py
recursive-include lmcache *.yaml
recursive-include lmcache *.json

# Include tests
recursive-include tests *.py

# Include documentation
recursive-include docs *.md *.rst *.txt

# Exclude build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .git*
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll